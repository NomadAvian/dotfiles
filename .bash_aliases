# kitty shortcuts
alias icat='kitten icat'

# bash helpers
alias ..='cd ../'
alias ...='cd ../../'
alias home='cd ~'
alias bashrc='source ~/.bashrc'

# fzf
alias fda='fdfind'

# git helpers
alias gs='git status'
alias gb='git branch'

# tmux default startup
alias plex='tmux new-session -A -s Plex -n Main'

# docker ollama shortcuts
alias qchat='~/Services/llm/llm.py'

# XAMPP shortcut
alias xampp='sudo /opt/lampp/xampp'

# VCV Rack 2
alias rack='(cd /opt/Rack2Free && ./Rack)'

# custom pomodoro timer
alias pomodoro='~/Services/pomodoro/pomodoro'

# python
alias py='python3'
alias venv='source ./.venv/bin/activate'

