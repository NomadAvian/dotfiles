# kitty shortcuts
alias icat='kitten icat'

# bash helpers
alias ..='cd ../'
alias ...='cd ../../'
alias home='cd ~'
alias bashrc='source ~/.bashrc'

# git helpers
alias gs='git status'
alias gb='git branch'

# tmux default startup
alias plex='tmux new-session -A -s Plex -n serv \; new-window -n main'

# python
alias py='python3'
alias venv='source ./.venv/bin/activate'

