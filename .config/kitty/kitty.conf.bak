font_family        JetBrains Mono
bold_font          auto
italic_font        auto
bold_italic_font   auto
font_size          12

# CURSOR HIDE
mouse_hide_wait -5.0

# BEGIN_KITTY_THEME
# Cyberpunk
include current-theme.conf
# END_KITTY_THEME

# WINDOW SETTINGS
window_padding_width 4

# CURSOR
cursor_trail 500
cusor_trail_decay 0.1 0.4
cursor_trail_start_threshold 2
